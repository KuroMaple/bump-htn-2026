DATABASE_URL=postgres://bump:bump@localhost:5432/bump
GATEWAY_API_KEY=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-different-long-random-secret
PORT=8787
PUBLIC_APP_URL=http://localhost:5173
DEDUPE_WINDOW_SECONDS=60

# Optional: HTN OS badge terminal (set both to enable the screen output).
BADGE_TERMINAL_ID=
BADGE_TERMINAL_KEY=

# Optional: HTN OS bump detector — JSON array, one object per badge you own.
# Each badge streams accel; coincident shakes register a bump and push the
# other person's mandela to your screen.
# HTNOS_BADGES=[{"id":"xb2b9","key":"hunter2","hardwareId":"e8:3d:c1:29:87:00"}]

# Optional: enables the explicit "Match teams" action on the projector.
# Keep the real key only in .env (which is gitignored), never in client code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
TEAM_MATCH_MIN_CONFIDENCE=0.75
