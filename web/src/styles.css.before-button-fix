/* =========================================================
   TYPOGRAPHY + HIGHLIGHT BUTTON
   ========================================================= */

/* Base font */
body,
button,
input,
select,
textarea {
  font-family:
    Helvetica,
    "Helvetica Neue",
    Arial,
    sans-serif !important;
}

/* Highlight/display font */
h1,
h2,
h3,
h4,
h5,
h6,
.brand-mark__name,
.eyebrow {
  font-family:
    Clarendon,
    "Clarendon LT Std",
    Rockwell,
    Georgia,
    serif !important;
}

/* Navy highlight / primary buttons */
.admin-toolbar button,
.register-panel button,
.stage-message button {
  background: var(--quilt-blue) !important;
  color: #ffffff !important;
  border-color: var(--quilt-blue) !important;
}

/* White accents inside highlight buttons */
.admin-toolbar button svg,
.register-panel button svg,
.stage-message button svg {
  color: #ffffff !important;
  stroke: #ffffff !important;
}

/* Hover state */
.admin-toolbar button:hover,
.register-panel button:hover,
.stage-message button:hover {
  background: #1b2a4a !important;
  color: #ffffff !important;
}

/* Force preview/highlight button to always be navy */
.icon-button,
.icon-button:hover,
.icon-button:focus,
.icon-button:active {
  background: var(--quilt-blue) !important;
  color: #ffffff !important;
  border-color: var(--quilt-blue) !important;
}

/* Keep SVG/icon accents white too */
.icon-button svg {
  color: #ffffff !important;
  stroke: #ffffff !important;
}

/* Final projector button styling */
.projector-header .icon-button,
.projector-header .icon-button:hover,
.projector-header .icon-button:focus,
.projector-header .icon-button:active {
  background: #243c73 !important;
  background-color: #243c73 !important;
  background-image: none !important;
  color: #ffffff !important;
  border: 1px solid #243c73 !important;
}

.projector-header .icon-button svg {
  color: #ffffff !important;
  stroke: #ffffff !important;
}
